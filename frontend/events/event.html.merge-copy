        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            background: var(--background);
            color: var(--text);
            line-height: 1.65;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font: inherit;
        }

        img,
        video {
            display: block;
            max-width: 100%;
        }

        .container {
            width: min(1160px, calc(100% - 40px));
            margin-inline: auto;
        }

        /* HEADER */

        .site-header {
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(14px);
        }

        .navbar {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .brand-logo {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: linear-gradient(135deg, #1d4ed8, #172554);
            color: white;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -1px;
            box-shadow: 0 5px 15px rgba(29, 78, 216, 0.2);
        }

        .brand-name {
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0.3px;
            color: var(--primary-dark);
        }

        .brand-subtitle {
            color: var(--muted);
            font-size: 12px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .nav-links a {
            font-size: 14px;
            font-weight: 600;
            color: #475569;
            transition: color 0.2s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--primary);
        }

        .menu-toggle {
            display: none;
            width: 42px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: white;
            cursor: pointer;
            font-size: 21px;
        }

