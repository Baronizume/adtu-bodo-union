        .media-card {
            position: relative;
            min-width: 0;
            overflow: hidden;
            background: #f1f5f9;
            border-radius: 14px;
            aspect-ratio: 4 / 3;
            border: 1px solid var(--border);
        }

        .media-card img,
        .media-card video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .media-card img {
            cursor: zoom-in;
            transition: transform 0.35s;
        }

        .media-card:hover img {
            transform: scale(1.045);
