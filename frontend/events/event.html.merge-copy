        /* LOADING */

        .skeleton {
            background: linear-gradient(
                90deg,
                #e2e8f0 25%,
                #f8fafc 50%,
                #e2e8f0 75%
            );
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 12px;
        }

        .loading-hero {
            min-height: 300px;
            margin-bottom: 28px;
            border-radius: 26px;
        }

        .loading-line {
            height: 17px;
            margin: 14px 0;
        }

        @keyframes shimmer {
            from { background-position: 200% 0; }
            to { background-position: -200% 0; }
        }

