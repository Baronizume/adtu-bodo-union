        const API_BASE_URL = "";
        const $ = (id) => document.getElementById(id);

        const eventName = $("eventName");
        const eventDate = $("eventDate");
        const eventLocation = $("eventLocation");
        const eventDescription = $("eventDescription");
        const eventContainer = $("event-details-container");

        const photoCount = $("photoCount");
        const videoCount = $("videoCount");
        const photoGallery = $("photoGallery");
        const videoGallery = $("videoGallery");
        const photoEmpty = $("photoEmpty");
        const videoEmpty = $("videoEmpty");
        const mediaStatus = $("mediaStatus");

        const lightbox = $("lightbox");
        const lightboxImage = $("lightboxImage");
        const lightboxClose = $("lightboxClose");

        const eventId = new URLSearchParams(window.location.search).get("id");
        $("year").textContent = new Date().getFullYear();

        function apiUrl(path) {
            const normalizedPath = path.startsWith("/") ? path : "/" + path;
            return API_BASE_URL.replace(/\/$/, "") + normalizedPath;
        }

        async function fetchJson(url) {
            const response = await fetch(url, {
                headers: { Accept: "application/json" }
            });

            let result;
            try {
                result = await response.json();
            } catch {
                throw new Error("Invalid server response (" + response.status + ").");
            }

            if (!response.ok) {
                throw new Error(result.message || "Request failed (" + response.status + ").");
            }

            return result;
        }

        function formatDate(value) {
            if (!value) return "Date not available";

            const raw = String(value);
            const parsed = new Date(
                /^\d{4}-\d{2}-\d{2}$/.test(raw) ? raw + "T00:00:00" : raw
            );

            if (Number.isNaN(parsed.getTime())) return raw;

            return parsed.toLocaleDateString("en-IN", {
                day: "numeric",
                month: "long",
                year: "numeric"
            });
        }

        function displayEvent(data) {
            const title = data.title || data.name || data.eventName || "Untitled Event";

            eventName.textContent = title;
            eventDate.textContent = "📅 " + formatDate(data.date);
            eventLocation.textContent =
                "📍 " + (data.location || data.venue || "Location not available");
            eventDescription.textContent =
                data.description || "No description available.";

            document.title = title + " | ADTU Bodo Union";
        }

        function getMediaUrl(media) {
            let candidate = "";

            if (typeof media === "string") {
                candidate = media;
            } else if (media && typeof media === "object") {
                candidate = media.url || media.secure_url || media.path ||
                    media.image || media.video || "";
            }

            if (typeof candidate !== "string") return "";
            candidate = candidate.trim();

            if (!candidate) return "";
            if (/^https?:\/\//i.test(candidate)) return candidate;
            if (candidate.startsWith("//")) return window.location.protocol + candidate;
            if (/^(data:|blob:)/i.test(candidate)) return candidate;

            return apiUrl(candidate);
        }

        function getMediaName(media, index, type) {
            if (media && typeof media === "object") {
                return media.originalName || media.originalname ||
                    media.filename || media.name || type + " " + (index + 1);
            }

            if (typeof media === "string") {
                const part = media.split("/").pop().split("?")[0];
                try {
                    return decodeURIComponent(part) || type + " " + (index + 1);
                } catch {
                    return part || type + " " + (index + 1);
                }
            }

            return type + " " + (index + 1);
        }

        function setMediaStatus(message, kind = "") {
            mediaStatus.textContent = message;
            mediaStatus.className = "status-message" + (kind ? " " + kind : "");
        }

        function openLightbox(url, alt) {
            lightboxImage.src = url;
            lightboxImage.alt = alt || "Event photo";
            lightbox.classList.add("active");
            lightboxClose.focus();
        }

        function closeLightbox() {
            lightbox.classList.remove("active");
            lightboxImage.src = "";
        }

        lightboxClose.addEventListener("click", closeLightbox);

        lightbox.addEventListener("click", (event) => {
            if (event.target === lightbox) closeLightbox();
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeLightbox();
        });

        function displayPhotos(photos) {
            photoGallery.replaceChildren();

            (Array.isArray(photos) ? photos : []).forEach((photo, index) => {
                const url = getMediaUrl(photo);
                if (!url) return;

                const card = document.createElement("article");
                card.className = "media-card";

                const image = document.createElement("img");
                image.src = url;
                image.alt = getMediaName(photo, index, "Photo");
                image.loading = "lazy";
                image.decoding = "async";
                image.addEventListener("click", () => openLightbox(url, image.alt));
                image.addEventListener("error", () => {
                    console.error("Photo failed to load:", url);
                });

                const caption = document.createElement("p");
                caption.className = "media-name";
                caption.textContent = getMediaName(photo, index, "Photo");

                card.append(image, caption);
                photoGallery.appendChild(card);
            });

            photoCount.textContent = "📷 Photos: " + photoGallery.children.length;
            photoEmpty.hidden = photoGallery.children.length > 0;
        }

        function displayVideos(videos) {
            videoGallery.replaceChildren();

            (Array.isArray(videos) ? videos : []).forEach((video, index) => {
                const url = getMediaUrl(video);
                if (!url) return;

                const card = document.createElement("article");
                card.className = "media-card";

                const player = document.createElement("video");
                player.controls = true;
                player.preload = "metadata";
                player.playsInline = true;
                player.src = url;
                player.setAttribute("aria-label", getMediaName(video, index, "Video"));
                player.addEventListener("error", () => {
                    console.error("Video failed to load:", url, player.error);
                });

                const caption = document.createElement("p");
                caption.className = "media-name";
                caption.textContent = getMediaName(video, index, "Video");

                card.append(player, caption);
                videoGallery.appendChild(card);
            });

            videoCount.textContent = "🎥 Videos: " + videoGallery.children.length;
            videoEmpty.hidden = videoGallery.children.length > 0;
        }

        function extractEvent(result) {
            if (!result || typeof result !== "object") return null;
            if (result.success === false) throw new Error(result.message || "Event not found.");
            if (result.data && typeof result.data === "object") return result.data;
            if (result.event && typeof result.event === "object") return result.event;

            if (result.success === undefined &&
                (result._id || result.id || result.title || result.name)) {
                return result;
            }

            return null;
        }

        // Correct backend endpoint: /api/upload/event/:eventId
        async function loadEventMedia() {
            const result = await fetchJson(
                apiUrl("/api/upload/event/" + encodeURIComponent(eventId))
            );

            if (result.success === false) {
                throw new Error(result.message || "Could not load media.");
            }

            displayPhotos(Array.isArray(result.photos) ? result.photos : []);
            displayVideos(Array.isArray(result.videos) ? result.videos : []);

            setMediaStatus(
                "Loaded " + photoGallery.children.length +
                " photo(s) and " + videoGallery.children.length + " video(s).",
                "success"
            );
        }

        function showError(message) {
            eventContainer.replaceChildren();

            const wrapper = document.createElement("div");
            wrapper.className = "not-found";

            const icon = document.createElement("div");
            icon.style.fontSize = "50px";
            icon.style.marginBottom = "15px";
            icon.textContent = "⚠️";

            const heading = document.createElement("h1");
            heading.textContent = message;

            const paragraph = document.createElement("p");
            paragraph.textContent =
                "The event could not be loaded. Check the event ID and server API.";

            const link = document.createElement("a");
            link.href = "../index.html#events";
            link.className = "button button-primary";
            link.textContent = "← Back to Events";

            wrapper.append(icon, heading, paragraph, link);
            eventContainer.appendChild(wrapper);
        }

        async function loadEvent() {
            if (!eventId || !eventId.trim()) {
                showError("Event ID is missing.");
                return;
            }

            try {
                const result = await fetchJson(
                    apiUrl("/api/events/" + encodeURIComponent(eventId))
                );

                const data = extractEvent(result);
                if (!data) throw new Error("Event not found. The API returned no event data.");

                displayEvent(data);

                try {
                    await loadEventMedia();
                } catch (error) {
                    console.error("Media loading error:", error);
                    displayPhotos([]);
                    displayVideos([]);
                    setMediaStatus(
                        "Event details loaded, but media could not be loaded: " + error.message,
                        "error"
                    );
                }
            } catch (error) {
                console.error("Event loading error:", error);
                showError(error.message || "Could not load the event.");
            }
        }

        console.log("ADTU BODO UNION EVENT PAGE", {
            eventId,
            apiOrigin: API_BASE_URL || window.location.origin
        });
=======

        /*
         * API CONFIGURATION
         * This page and the API are hosted on the same Render domain.
         */
        const API_BASE_URL = window.location.origin;

        const API = {
            event: (id) =>
                `${API_BASE_URL}/api/events/${encodeURIComponent(id)}`,

            media: (id) =>
                `${API_BASE_URL}/api/media/event/${encodeURIComponent(id)}`
        };

        const $ = (id) => document.getElementById(id);

        const elements = {
            loadingView: $("loadingView"),
            errorView: $("errorView"),
            errorMessage: $("errorMessage"),
            eventPage: $("eventPage"),
            eventTitle: $("eventTitle"),
            breadcrumbTitle: $("breadcrumbTitle"),
            heroDate: $("heroDate"),
            heroLocation: $("heroLocation"),
            eventStatus: $("eventStatus"),
            eventDescription: $("eventDescription"),
            detailDate: $("detailDate"),
            detailLocation: $("detailLocation"),
            pageStatus: $("pageStatus"),
            photoCount: $("photoCount"),
            videoCount: $("videoCount"),
            photoSubtitle: $("photoSubtitle"),
            videoSubtitle: $("videoSubtitle"),
            photoGallery: $("photoGallery"),
            videoGallery: $("videoGallery"),
            lightbox: $("lightbox"),
            lightboxImage: $("lightboxImage"),
            lightboxCaption: $("lightboxCaption")
        };

        const params = new URLSearchParams(window.location.search);
        const eventId = params.get("id");

        let currentEvent = null;
        let requestVersion = 0;

        /* ------------------------------
           GENERAL HELPERS
        ------------------------------ */

        function setVisible(element, visible) {
            element.hidden = !visible;
        }

        function showStatus(message, type = "info") {
            elements.pageStatus.textContent = message;
            elements.pageStatus.className =
                `status-message visible ${type}`;
        }

        function hideStatus() {
            elements.pageStatus.textContent = "";
            elements.pageStatus.className = "status-message";
        }

        function formatDate(value) {
            if (!value) return "Date not available";

            /*
             * Preserve YYYY-MM-DD calendar dates rather than allowing
             * timezone conversion to move the date backward.
             */
            const dateText = String(value);

            const match = dateText.match(/^(\d{4})-(\d{2})-(\d{2})/);

            let date;

            if (match) {
                date = new Date(
                    Number(match[1]),
                    Number(match[2]) - 1,
                    Number(match[3])
                );
            } else {
                date = new Date(value);
            }

            if (Number.isNaN(date.getTime())) {
                return dateText;
            }

            return new Intl.DateTimeFormat("en-IN", {
                day: "numeric",
                month: "long",
                year: "numeric"
            }).format(date);
        }

        function getEventStatus(value) {
            if (!value) {
                return { label: "Date unavailable", className: "past" };
            }

            const match = String(value).match(/^(\d{4})-(\d{2})-(\d{2})/);
            let date;

            if (match) {
                date = new Date(
                    Number(match[1]),
                    Number(match[2]) - 1,
                    Number(match[3])
                );
            } else {
                date = new Date(value);
            }

            if (Number.isNaN(date.getTime())) {
                return { label: "Event", className: "past" };
            }

            const today = new Date();
            today.setHours(0, 0, 0, 0);
            date.setHours(0, 0, 0, 0);

            if (date.getTime() === today.getTime()) {
                return { label: "Happening Today", className: "today" };
            }

            if (date > today) {
                return { label: "Upcoming Event", className: "upcoming" };
            }

            return { label: "Past Event", className: "past" };
        }

        async function fetchJSON(url) {
            const response = await fetch(url, {
                method: "GET",
                headers: {
                    "Accept": "application/json"
                },
                cache: "no-store"
            });

            const rawText = await response.text();

            let result;

            try {
                result = JSON.parse(rawText);
            } catch {
                throw new Error(
                    `The server returned an invalid response (HTTP ${response.status}).`
                );
            }

            if (!response.ok) {
                throw new Error(
                    result.message ||
                    `Request failed with status ${response.status}.`
                );
            }

            return result;
        }

        function showError(message) {
            setVisible(elements.loadingView, false);
            setVisible(elements.eventPage, false);
            setVisible(elements.errorView, true);

            elements.errorMessage.textContent = message;
        }

        function showEventPage() {
            setVisible(elements.loadingView, false);
            setVisible(elements.errorView, false);
            setVisible(elements.eventPage, true);
        }

        /* ------------------------------
           EVENT DETAILS
        ------------------------------ */

        function displayEvent(event) {
            if (!event || typeof event !== "object") {
                throw new Error("The event information is missing.");
            }

            currentEvent = event;

            const title = event.title || event.name || "Untitled Event";
            const date = formatDate(event.date);
            const location = event.location || "Location not specified";
            const description =
                event.description || "No description has been provided for this event.";

            elements.eventTitle.textContent = title;
            elements.breadcrumbTitle.textContent = title;
            elements.heroDate.textContent = date;
            elements.heroLocation.textContent = location;
            elements.eventDescription.textContent = description;
            elements.detailDate.textContent = date;
            elements.detailLocation.textContent = location;

            const status = getEventStatus(event.date);

            elements.eventStatus.textContent = status.label;
            elements.eventStatus.className =
                `event-status ${status.className}`;

            document.title = `${title} | ADTU Bodo Union`;
        }

        /* ------------------------------
           MEDIA URL HELPERS
        ------------------------------ */

        function getMediaUrl(item) {
            if (typeof item === "string") {
                return item;
            }

            if (!item || typeof item !== "object") {
                return "";
            }

            return (
                item.secure_url ||
                item.url ||
                item.imageUrl ||
                item.videoUrl ||
                item.image ||
                item.video ||
                item.src ||
                item.path ||
                item.fileUrl ||
                item.cloudinaryUrl ||
                ""
            );
        }

        function getMediaTitle(item, index, type) {
            if (item && typeof item === "object") {
                return (
                    item.title ||
                    item.originalName ||
                    item.filename ||
                    item.name ||
                    `${type} ${index + 1}`
                );
            }

            return `${type} ${index + 1}`;
        }

        function normalizeMediaArray(value) {
            if (Array.isArray(value)) {
                return value;
            }

            if (value && typeof value === "object") {
                return Object.values(value);
            }

            return [];
        }

        function createEmptyState(icon, title, message) {
            const wrapper = document.createElement("div");
            wrapper.className = "empty-state";

            const iconElement = document.createElement("div");
            iconElement.className = "empty-state-icon";
            iconElement.textContent = icon;

            const heading = document.createElement("h4");
            heading.textContent = title;

            const description = document.createElement("p");
            description.textContent = message;

            wrapper.append(iconElement, heading, description);

            return wrapper;
        }

        /* ------------------------------
           PHOTO GALLERY
        ------------------------------ */

        function displayPhotos(photos) {
            elements.photoGallery.replaceChildren();

            const validPhotos = photos
                .map((item, index) => ({
                    item,
                    index,
                    url: getMediaUrl(item),
                    title: getMediaTitle(item, index, "Photo")
                }))
                .filter((photo) => Boolean(photo.url));

            elements.photoCount.textContent =
                `${validPhotos.length} ${validPhotos.length === 1 ? "Photo" : "Photos"}`;

            elements.photoSubtitle.textContent =
                `${validPhotos.length} ${validPhotos.length === 1 ? "photo" : "photos"}`;

            if (validPhotos.length === 0) {
                elements.photoGallery.appendChild(
                    createEmptyState(
                        "📷",
                        "No photos uploaded yet",
                        "Photos from this event will appear here when available."
                    )
                );
                return;
            }

            validPhotos.forEach(({ url, title }) => {
                const card = document.createElement("div");
                card.className = "media-card";

                const image = document.createElement("img");
                image.src = url;
                image.alt = title;
                image.loading = "lazy";

                image.addEventListener("click", () => {
                    openLightbox(url, title);
                });

                image.addEventListener("error", () => {
                    card.replaceChildren(
                        createEmptyState(
                            "⚠️",
                            "Photo unavailable",
                            "This image could not be loaded."
                        )
                    );
                }, { once: true });

                const caption = document.createElement("div");
                caption.className = "media-caption";
                caption.textContent = title;

                card.append(image, caption);
                elements.photoGallery.appendChild(card);
            });
        }

        /* ------------------------------
           VIDEO GALLERY
        ------------------------------ */

        function displayVideos(videos) {
            elements.videoGallery.replaceChildren();

            const validVideos = videos
                .map((item, index) => ({
                    item,
                    index,
                    url: getMediaUrl(item),
                    title: getMediaTitle(item, index, "Video")
                }))
                .filter((video) => Boolean(video.url));

            elements.videoCount.textContent =
                `${validVideos.length} ${validVideos.length === 1 ? "Video" : "Videos"}`;

            elements.videoSubtitle.textContent =
                `${validVideos.length} ${validVideos.length === 1 ? "video" : "videos"}`;

            if (validVideos.length === 0) {
                elements.videoGallery.appendChild(
                    createEmptyState(
                        "🎥",
                        "No videos uploaded yet",
                        "Videos from this event will appear here when available."
                    )
                );
                return;
            }

            validVideos.forEach(({ url, title }) => {
                const card = document.createElement("div");
                card.className = "media-card";

                const video = document.createElement("video");
                video.src = url;
                video.controls = true;
                video.preload = "metadata";
                video.playsInline = true;
                video.setAttribute("aria-label", title);

                const caption = document.createElement("div");
                caption.className = "media-caption";
                caption.textContent = title;

                video.addEventListener("error", () => {
                    caption.textContent = "Video could not be loaded";
                }, { once: true });

                card.append(video, caption);
                elements.videoGallery.appendChild(card);
            });
        }

        /* ------------------------------
           LOAD EVENT MEDIA
        ------------------------------ */

        async function loadEventMedia() {
            if (!eventId) return;

            try {
                const result = await fetchJSON(API.media(eventId));

                if (result.success !== true) {
                    throw new Error(
                        result.message || "The media API did not return success."
                    );
                }

                /*
                 * Supports either:
                 * { photos: [], videos: [] }
                 * or { data: { photos: [], videos: [] } }
                 */
                const payload = result.data || result;

                const photos = normalizeMediaArray(
                    payload.photos || payload.images
                );

                const videos = normalizeMediaArray(
                    payload.videos || payload.video
                );

                displayPhotos(photos);
                displayVideos(videos);

            } catch (error) {
                console.error("Event media loading error:", error);

                displayPhotos([]);
                displayVideos([]);

                showStatus(
                    "Event details loaded, but the photo and video gallery could not be retrieved. Please try refreshing the page.",
                    "info"
                );
            }
        }

        /* ------------------------------
           LOAD EVENT FROM MONGODB API
        ------------------------------ */

        async function loadEvent() {
            const thisRequest = ++requestVersion;

            hideStatus();
            setVisible(elements.errorView, false);
            setVisible(elements.eventPage, false);
            setVisible(elements.loadingView, true);

            if (!eventId) {
                showError(
                    "No event ID was found in the link. Please return to the Events page and select an event."
                );
                return;
            }

            try {
                const result = await fetchJSON(API.event(eventId));

                if (thisRequest !== requestVersion) return;

                console.log("Event API response:", result);

                if (
                    result.success !== true ||
                    !result.data ||
                    typeof result.data !== "object"
                ) {
                    throw new Error(
                        result.message || "The requested event was not found."
                    );
                }

                displayEvent(result.data);
                showEventPage();

                /*
                 * The event remains visible if its media endpoint fails.
                 */
                await loadEventMedia();

            } catch (error) {
                if (thisRequest !== requestVersion) return;

                console.error("Event loading error:", error);

                showError(
                    error.message ||
                    "Failed to load event details. Please try again."
                );
            }
        }

        /* ------------------------------
           LIGHTBOX
        ------------------------------ */

        function openLightbox(url, title) {
            elements.lightboxImage.src = url;
            elements.lightboxImage.alt = title;
            elements.lightboxCaption.textContent = title;

            elements.lightbox.classList.add("open");
            document.body.style.overflow = "hidden";

            $("lightboxClose").focus();
        }

        function closeLightbox() {
            elements.lightbox.classList.remove("open");
            elements.lightboxImage.removeAttribute("src");
            document.body.style.overflow = "";
        }

        $("lightboxClose").addEventListener("click", closeLightbox);

        elements.lightbox.addEventListener("click", (event) => {
            if (event.target === elements.lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeLightbox();
            }
        });

        /* ------------------------------
           MOBILE NAVIGATION
        ------------------------------ */

        $("menuToggle").addEventListener("click", () => {
            const isOpen = elementsNavIsOpen();

            $("navLinks").classList.toggle("open", !isOpen);

            $("menuToggle").setAttribute(
                "aria-expanded",
                String(!isOpen)
            );
        });

        function elementsNavIsOpen() {
            return $("navLinks").classList.contains("open");
        }

        $("navLinks").querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                $("navLinks").classList.remove("open");
                $("menuToggle").setAttribute("aria-expanded", "false");
            });
        });

        /* ------------------------------
           RETRY + INITIALIZATION
        ------------------------------ */

        $("retryButton").addEventListener("click", loadEvent);

        $("currentYear").textContent = new Date().getFullYear();
>>>>>>> 5ad861156f4f8c02a905a7b836a869ba4d9441bb

