const app = express();
const PORT = process.env.PORT || 5000;

app.use(cors());
app.use(express.json({ limit: "10mb" }));
app.use(express.urlencoded({ extended: true, limit: "10mb" }));

/* Frontend and media folders */

const frontendPath = path.resolve(__dirname, "../frontend");
const mediaPath = path.join(frontendPath, "media");

fs.mkdirSync(mediaPath, { recursive: true });

app.use("/media", express.static(mediaPath));
app.use(express.static(frontendPath));

/* Firebase initialization */

let firebaseReady = false;

try {
    if (admin.apps.length > 0) {
        firebaseReady = true;
    } else if (process.env.FIREBASE_SERVICE_ACCOUNT_JSON) {
        const serviceAccount = JSON.parse(
            process.env.FIREBASE_SERVICE_ACCOUNT_JSON
        );

        admin.initializeApp({
            credential: admin.credential.cert(serviceAccount)
        });

        firebaseReady = true;
    } else if (process.env.GOOGLE_APPLICATION_CREDENTIALS) {
        admin.initializeApp({
            credential: admin.credential.applicationDefault()
        });

        firebaseReady = true;
    }
} catch (error) {
    console.error("Firebase initialization error:", error.message);
}

/* Health check */

app.get("/health", (req, res) => {
    res.json({
        success: true,
        message: "ADTU Bodo Union backend is running.",
        mongodb: mongoose.connection.readyState === 1
            ? "connected"
            : "disconnected",
        firebase: firebaseReady ? "configured" : "not configured"
    });
});

/* Events list */

app.get("/api/events", async (req, res) => {
    try {
        const events = await Event.find()
            .sort({ date: 1, createdAt: -1 })
            .lean();

        res.json(events);
    } catch (error) {
        console.error("Fetch events error:", error);

        res.status(500).json({
            success: false,
            message: "Failed to fetch events."
        });
    }
});

/* Event creation and deletion routes */

app.use("/api/events", eventRoutes);

/* Single event lookup */

app.get("/api/events/:id", async (req, res) => {
    const id = String(req.params.id || "").trim();

    try {
        if (/^[a-fA-F0-9]{24}$/.test(id)) {
            const event = await Event.findById(id).lean();

            if (event) {
                return res.json({
                    success: true,
                    source: "mongodb",
                    data: {
                        ...event,
                        id: String(event._id)
                    }
                });
            }
        }

        if (firebaseReady) {
            const doc = await admin.firestore()
                .collection("events")
                .doc(id)
                .get();

            if (doc.exists) {
                return res.json({
                    success: true,
                    source: "firebase",
                    data: { id: doc.id, ...doc.data() }
                });
            }
        }

        res.status(404).json({
            success: false,
            message: "Event not found."
        });
    } catch (error) {
        console.error("Single event error:", error);

        res.status(500).json({
            success: false,
            message: "Failed to load event."
        });
    }
